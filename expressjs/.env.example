# Docker Compose tự đọc .env trong thư mục expressjs (không bắt buộc).
APP_PORT=3069
MYSQL_PORT=3307
MYSQL_ROOT_PASSWORD=root_local_password
# Dùng mật khẩu URL-safe vì giá trị này được ghép vào DATABASE_URL.
MYSQL_PASSWORD=express_local_password

# Dành cho chạy Node trực tiếp trên máy; Compose dùng hostname mysql bên trong Docker.
DATABASE_URL=mysql://express:express_local_password@localhost:3307/nodejs_56
ACCESS_TOKEN_SECRET_KEY=local-access-token-secret-change-me
REFRESH_TOKEN_SECRET_KEY=local-refresh-token-secret-change-me

# Thay cả hai giá trị bằng OAuth credentials thật nếu cần đăng nhập Google.
GOOGLE_CLIENT_ID=local-google-client-id
GOOGLE_CLIENT_SECRET=local-google-client-secret
